# Supabase project that backs Google sign-in and cross-device progress.
# Both values are safe to expose in the browser: the publishable key only
# grants what row-level security allows, which is a learner's own progress row.
# Leave them unset and the app runs local-only, saving progress to localStorage.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Supabase Edge Function that backs the AI interviewer in practice
# mode. Leave unset and the scripted interviewer runs instead, with no network
# calls and no key. See INTERVIEWER.md.
VITE_INTERVIEW_ENDPOINT=https://your-project-ref.functions.supabase.co/interview
